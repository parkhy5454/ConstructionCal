# Neon에서 발급받은 Postgres 연결 문자열 (Vercel에서 Neon 연동 시 자동으로 채워짐)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# 세션 서명용 비밀키. 아래 명령으로 생성해서 넣으세요 (절대 커밋하지 마세요):
#   openssl rand -base64 48
JWT_SECRET="여기에_32자_이상의_랜덤_문자열을_생성해서_넣으세요"

# ---------- 선택: 이메일 인증 (Resend https://resend.com) ----------
# 아래 두 값이 모두 있어야 가입 시 인증 메일을 보내고, 인증 전 로그인을 막습니다. 비워두면 이메일 인증은 꺼진 채로 동작합니다.
# EMAIL_FROM의 도메인은 Resend에서 DNS 인증(SPF/DKIM)을 마쳐야 합니다.
RESEND_API_KEY=""
EMAIL_FROM="ConCal <noreply@내도메인.com>"
# 인증 메일 링크의 기준 주소(권장). 예: https://내서비스.vercel.app
APP_URL=""
# 메일 설정은 했지만 일시적으로 인증 요구만 끄고 싶을 때 "false"
# 계정당 동시 로그인 1대 제한(기본 켜짐). 끄려면 false
# SINGLE_SESSION="false"
# REQUIRE_EMAIL_VERIFICATION="false"

# 무료 체험 일수. 0 또는 미설정이면 체험/읽기 전용 기능이 꺼져 모두 제한 없이 사용(기본).
# 켜면: 첫 이용부터 N일 체험 → 종료 후 읽기 전용(관리자는 제외, 관리자 화면에서 구독 연장 가능)
# TRIAL_DAYS="14"

# 체험/구독 종료 안내 메일 크론(vercel.json, 매일 1회) 인증 키. 미설정이면 크론은 503으로 거부됨.
# Vercel Cron은 이 값을 Authorization: Bearer 로 자동 전송합니다. 메일(RESEND_*)과 TRIAL_DAYS가 모두 켜져 있어야 발송.
# CRON_SECRET=""
# 추천 보상 일수(추천받은 사람이 승인되면 양쪽에 연장). 기본 30, 0이면 끔. TRIAL_DAYS가 켜져 있어야 동작.
# REFERRAL_REWARD_DAYS="30"
# 문의하기 접수 시 알림을 받을 이메일(선택, 메일 설정 필요). 문의는 관리자 화면에도 쌓입니다.
# SUPPORT_EMAIL=""

# 오류 알림 웹훅(Slack/Discord 수신 웹훅 URL, https). 없으면 서버 로그에만 남습니다.
# ERROR_WEBHOOK_URL=""
