# Neon에서 발급받은 Postgres 연결 문자열 (Vercel에서 Neon 연동 시 자동으로 채워짐)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# 세션 서명용 비밀키. 아래 명령으로 생성해서 넣으세요 (절대 커밋하지 마세요):
#   openssl rand -base64 48
JWT_SECRET="여기에_32자_이상의_랜덤_문자열을_생성해서_넣으세요"

# ---------- 선택: 이메일 인증 (Resend https://resend.com) ----------
# 아래 두 값이 모두 있어야 가입 시 인증 메일을 보내고, 인증 전 로그인을 막습니다. 비워두면 이메일 인증은 꺼진 채로 동작합니다.
# EMAIL_FROM의 도메인은 Resend에서 DNS 인증(SPF/DKIM)을 마쳐야 합니다.
RESEND_API_KEY=""
EMAIL_FROM="ConCal <noreply@내도메인.com>"
# 인증 메일 링크의 기준 주소(권장). 예: https://내서비스.vercel.app
APP_URL=""
# 메일 설정은 했지만 일시적으로 인증 요구만 끄고 싶을 때 "false"
# REQUIRE_EMAIL_VERIFICATION="false"
